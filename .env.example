# Copy this file to .env.local and fill in your Supabase project values.
# Find them in Supabase: Project Settings → API Keys (and Data API for the URL).
#
# Only the PUBLISHABLE key (sb_publishable_…) or the legacy "anon" key belongs
# here. Never put the secret / service_role key in any VITE_ variable — Vite
# bundles every VITE_ variable into the public JavaScript.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
